# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Database Connectivity (Atlas or Local)
# If provided, complaints will persist in MongoDB, otherwise they fall back to complaints.json.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="manu_ai"

# Supabase Auth Configuration
# Used for enterprise authentication integration.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Cloudinary Storage Configuration
# Used for persistent hosting of uploaded evidence images.
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Hugging Face AI API Configuration
# Used for alternative speech or translation models.
HUGGINGFACE_API_KEY="your-huggingface-api-key"
